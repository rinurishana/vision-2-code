        .app-icon.settings .gear-teeth:nth-child(1) { transform: translateX(-50%) rotate(0deg); }
        .app-icon.settings .gear-teeth:nth-child(2) { transform: translateX(-50%) rotate(60deg); }
        .app-icon.settings .gear-teeth:nth-child(3) { transform: translateX(-50%) rotate(120deg); }
        .app-icon.settings .gear-teeth:nth-child(4) { transform: translateX(-50%) rotate(180deg); }
        .app-icon.settings .gear-teeth:nth-child(5) { transform: translateX(-50%) rotate(240deg); }
        .app-icon.settings .gear-teeth:nth-child(6) { transform: translateX(-50%) rotate(300deg); }

        .app-icon.calculator { background-color: #e0e0e0; }
