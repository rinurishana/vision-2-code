        .app-icon.weather .sun::before {
            content: '';
            position: absolute;
            width: 6px;
            height: 6px;
            background-color: #ffdd80;
            border-radius: 50%;
            top: -4px;
            left: 8px;
            box-shadow: -15px 0px 0 #ffdd80, 15px 0px 0 #ffdd80, 0 -15px 0 #ffdd80, 0 15px 0 #ffdd80;
