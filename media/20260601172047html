        .app-icon.weather .cloud::after { left: 18px; }

        .app-icon.settings { background-color: #e0e0e0; }
        .app-icon.settings .gear {
            width: 36px;
            height: 36px;
            border: 4px solid #333;
            border-radius: 50%;
            position: relative;
