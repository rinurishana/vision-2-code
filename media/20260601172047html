        .app-icon.photos .petal:nth-child(2) { background-color: #ffc200; }
        .app-icon.photos .petal:nth-child(3) { background-color: #a1ce00; }
        .app-icon.photos .petal:nth-child(4) { background-color: #00a600; }
        .app-icon.photos .petal:nth-child(5) { background-color: #00a0e9; }
        .app-icon.photos .petal:nth-child(6) { background-color: #993fcc; }

        .app-icon.weather { background-color: #4ab8ff; }
