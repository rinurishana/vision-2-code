        .app-icon.calculator .calc-button:nth-child(8) { background-color: #ccc; }
        .app-icon.calculator .calc-button:nth-child(3),
        .app-icon.calculator .calc-button:nth-child(6),
        .app-icon.calculator .calc-button:nth-child(9) { background-color: #ccc; }
        .app-icon.calculator .calc-button:nth-child(10) { background-color: #ccc; }
        .app-icon.calculator .calc-button:nth-child(11) { background-color: #ccc; }
        .app-icon.calculator .calc-button:nth-child(12) { background-color: #ccc; }

