        .app-icon.weather .cloud {
            position: absolute;
            bottom: 10px;
            left: 15px;
            width: 30px;
            height: 16px;
            background-color: #fff;
            border-radius: 10px;
        }
        .app-icon.weather .cloud::before,
        .app-icon.weather .cloud::after {
            content: '';
            position: absolute;
            width: 14px;
            height: 14px;
            background-color: #fff;
            border-radius: 50%;
