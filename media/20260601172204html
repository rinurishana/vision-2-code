
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>iPhone Home Screen</title>
    <style>
        :root {
            --yellow-background: #ffe180;
            --icon-background-light: #f2f2f7;
            --icon-background-dark: #2c2c2e;
            --notification-red: #ff3b30;
            --icon-border-radius: 15px;
            --app-icon-size: 70px;
            --app-label-font-size: 12px;
            --app-label-line-height: 1.2;
            --app-label-letter-spacing: -0.2px;
            --app-label-color: #1c1c1e;
            --header-font-size: 17px;
            --header-font-weight: 600;
            --header-color: #1c1c1e;
            --status-bar-font-size: 14px;
            --status-bar-font-weight: 600;
            --status-bar-color: #1c1c1e;
            --notification-badge-font-size: 12px;
            --notification-badge-font-weight: 600;
            --notification-badge-color: #ffffff;
            --notification-badge-padding: 2px 6px;
            --notification-badge-border-radius: 10px;
            --margin-between-apps: 20px;
            --margin-between-rows: 20px;
            --padding-app-container: 15px;
            --padding-row-container: 15px;
        }

        body {
            margin: 0;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            background-color: var(--yellow-background);
            display: flex;
            justify-content: center;
            align-items: flex-start;
            min-height: 100vh;
            padding-top: 40px; / Simulate status bar height /
            box-sizing: border-box;
        }

        .iphone-screen {
            width: 375px; / Typical iPhone width /
            background-color: var(--yellow-background);
            border-radius: 30px;
            padding: 0;
            box-shadow: 0 0 20px rgba(0, 0, 0, 0.1);
            overflow: hidden;
            position: relative;
        }

        .status-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 10px 20px;
            background-color: var(--yellow-background);
            color: var(--status-bar-color);
            font-size: var(--status-bar-font-size);
            font-weight: var(--status-bar-font-weight);
            height: 40px; / Approximate height of status bar /
        }

        .status-bar-time {
            text-align: center;
            flex-grow: 1;
        }

        .status-bar-right {
            display: flex;
            align-items: center;
        }

        .status-bar-icon {
            width: 18px;
            height: 18px;
            margin-left: 5px;
        }

        .content-area {
            padding: var(--padding-row-container);
        }

        .app-row {
            display: flex;
            justify-content: space-around;
            margin-bottom: var(--margin-between-rows);
        }

        .app-row:last-child {
            margin-bottom: 0;
        }

        .app-container {
            display: flex;
            flex-direction: column;
            align-items: center;
            width: calc((100% - (2  var(--margin-between-apps))) / 3);
        }

        .app-icon-wrapper {
            position: relative;
            display: flex;
            justify-content: center;
            align-items: center;
            width: var(--app-icon-size);
            height: var(--app-icon-size);
            background-color: var(--icon-background-light);
            border-radius: var(--icon-border-radius);
            margin-bottom: 8px; / Space between icon and label /
            box-sizing: border-box;
        }

        .app-icon-wrapper img {
            width: 50px; / Adjust icon image size /
            height: 50px; / Adjust icon image size /
            object-fit: contain;
        }
        
        .notification-badge {
            position: absolute;
            top: -5px;
            right: -10px;
            background-color: var(--notification-red);
            color: var(--notification-badge-color);
            font-size: var(--notification-badge-font-size);
            font-weight: var(--notification-badge-font-weight);
            padding: var(--notification-badge-padding);
            border-radius: var(--notification-badge-border-radius);
            display: flex;
            align-items: center;
            justify-content: center;
            min-width: 20px; / Ensure minimum width for numbers /
            height: 20px;
        }

        .app-label {
            font-size: var(--app-label-font-size);
            line-height: var(--app-label-line-height);
            letter-spacing: var(--app-label-letter-spacing);
            color: var(--app-label-color);
            text-align: center;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            width: 100%;
        }

