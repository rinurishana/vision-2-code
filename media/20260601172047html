        .app-icon.clock .clock-face::after {
            content: '';
            position: absolute;
            background-color: #333;
            transform-origin: 50% 100%;
        }
        .app-icon.clock .clock-face::before { width: 2px; height: 12px; top: 8px; left: 50%; margin-left: -1px; transform: rotate(270deg); }
        .app-icon.clock .clock-face::after { width: 2px; height: 8px; top: 12px; left: 50%; margin-left: -1px; transform: rotate(0deg); }
        .app-icon.clock .dot { width: 4px; height: 4px; background-color: #333; border-radius: 50%; position: absolute; top: 18px; left: 18px; }

        .app-icon.camera { background-color: #e0e0e0; }
        .app-icon.camera img { width: 30px; }

        .app-icon.photos { background-color: #ffffff; }
        .app-icon.photos .flower { display: grid; grid-template-columns: repeat(2, 1fr); width: 30px; height: 30px; margin: 0 auto; }
