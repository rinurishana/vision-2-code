<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pixel Perfect Replica</title>
    <style>
        body {
            margin: 0;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif, 'Apple Color Emoji', 'Segoe UI Emoji', 'Segoe UI Symbol';
            background-color: #ffdd80;
            display: flex;
            justify-content: center;
            align-items: flex-start;
            min-height: 100vh;
            overflow: hidden;
        }

        .iphone-screen {
            width: 375px;
            height: 812px;
            background-color: #ffdd80;
            position: relative;
            box-shadow: 0 0 20px rgba(0, 0, 0, 0.1);
            overflow: hidden;
        }

        .status-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 10px 20px;
            color: #333;
            font-size: 15px;
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            z-index: 100;
        }

        .status-bar-left span {
            margin-right: 5px;
        }

        .status-bar-right {
            display: flex;
            align-items: center;
        }

        .status-bar-right .icon {
            width: 15px;
            height: 10px;
            border: 1px solid #333;
            border-radius: 2px;
            margin-left: 5px;
            position: relative;
        }

        .status-bar-right .icon::after {
            content: '';
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 5px;
            height: 2px;
            background-color: #333;
            border-radius: 1px;
        }

        .app-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px 15px;
            padding: 70px 15px 20px;
            justify-content: center;
            align-items: start;
        }

        .app-icon-container {
            width: 80px;
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
            position: relative;
        }

        .app-icon {
            width: 64px;
            height: 64px;
            border-radius: 16px;
            display: flex;
            justify-content: center;
            align-items: center;
            margin-bottom: 8px;
            box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
            background-color: white;
            position: relative;
            overflow: hidden;
        }

        .app-label {
            font-size: 12px;
            color: #333;
            line-height: 1.3;
            letter-spacing: -0.2px;
            width: 100%;
            word-wrap: break-word;
        }

        .badge {
            position: absolute;
            top: -5px;
            right: -5px;
            background-color: #ff3b30;
            color: white;
            border-radius: 10px;
            font-size: 12px;
            font-weight: bold;
            padding: 2px 6px;
            min-width: 20px;
            height: 20px;
            display: flex;
            justify-content: center;
            align-items: center;
            box-sizing: border-box;
        }

        .badge.large {
            padding: 2px 8px;
            font-size: 10px;
            min-width: 25px;
        }

        .badge.extra-large {
            padding: 2px 10px;
            font-size: 9px;
            min-width: 30px;
        }

        .app-icon img {
            max-width: 100%;
            max-height: 100%;
            object-fit: contain;
        }

        .app-icon.calendar { background-color: #ffffff; }
        .app-icon.calendar .icon-day { font-size: 24px; font-weight: bold; color: #555; margin-bottom: -5px; }
        .app-icon.calendar .icon-month { font-size: 12px; color: #888; }

