<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>iOS Home Screen</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <style>
        @font-face {
            font-family: 'SF Pro Display';
            src: local('SF Pro Display Regular'), local('San Francisco Display Regular'),
                 url('https://sf-pro-fonts.vercel.app/SF-Pro-Display-Regular.otf') format('opentype');
            font-weight: 400;
            font-style: normal;
        }
        @font-face {
            font-family: 'SF Pro Display';
            src: local('SF Pro Display Medium'), local('San Francisco Display Medium'),
                 url('https://sf-pro-fonts.vercel.app/SF-Pro-Display-Medium.otf') format('opentype');
            font-weight: 500;
            font-style: normal;
        }
        @font-face {
            font-family: 'SF Pro Display';
            src: local('SF Pro Display Semibold'), local('San Francisco Display Semibold'),
                 url('https://sf-pro-fonts.vercel.app/SF-Pro-Display-Semibold.otf') format('opentype');
            font-weight: 600;
            font-style: normal;
        }

        :root {
            --ios-bg: rgb(255, 227, 140);
            --icon-size: 60px;
            --icon-border-radius: 17%;
            --status-bar-height: 20px;
            --dock-height: 80px;
            --dock-bg: rgba(255, 255, 255, 0.6);
            --app-label-color: #434343;
            --app-label-font-size: 11px;
            --app-label-line-height: 1.2;
            --badge-bg: #E63D31;
            --badge-color: white;
            --badge-font-size: 9px;
            --badge-padding: 0px 4px;
            --badge-border-radius: 9px;
            --badge-min-width: 18px;
            --badge-height: 18px;
            --badge-offset-x: -8px;
            --badge-offset-y: -8px;
            --grid-gap-x: 0px;
            --grid-gap-y: 18px;
        }

        html, body {
            margin: 0;
            padding: 0;
            height: 100%;
            font-family: 'SF Pro Display', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Oxygen-Sans, Ubuntu, Cantarell, "Helvetica Neue", sans-serif;
            overflow: hidden;
            display: flex;
            justify-content: center;
            align-items: center;
            background-color: #333;
        }

        .phone-mockup {
            width: 375px;
            height: 812px;
            background-color: var(--ios-bg);
            border-radius: 40px;
            box-shadow: 0 0 0 10px #000,
                        0 0 0 12px #333,
                        0 0 0 16px #000;
            position: relative;
            overflow: hidden;
        }

        .status-bar {
            height: var(--status-bar-height);
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0 14px;
            font-size: 12px;
            font-weight: 600;
            color: #434343;
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            z-index: 10;
        }

        .status-bar .left,
        .status-bar .right {
            display: flex;
            align-items: center;
            gap: 4px;
        }

        .status-bar .center {
            flex-grow: 1;
            text-align: center;
        }
        
        .airplane-mode-icon {
            transform: scale(0.8) rotate(45deg);
        }

        .battery-icon {
            width: 21px;
            height: 10px;
            border: 1px solid #434343;
            border-radius: 2px;
            position: relative;
            margin-left: 2px;
        }

        .battery-icon::before {
            content: '';
            position: absolute;
            top: 50%;
            right: -2px;
            transform: translateY(-50%);
            width: 2px;
            height: 4px;
            background-color: #434343;
            border-radius: 0 1px 1px 0;
        }

        .battery-level {
            height: 100%;
            width: 18%;
            background-color: #434343;
            border-radius: 1px;
        }


        .app-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: var(--grid-gap-y) var(--grid-gap-x);
            padding: 30px 10px 0 10px;
            margin-top: calc(var(--status-bar-height) + 10px);
            height: calc(100% - var(--status-bar-height) - var(--dock-height) - 40px - 20px);
            align-content: start;
        }

        .app-icon-wrapper {
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
            position: relative;
            padding: 8px 0;
        }

        .app-icon {
            width: var(--icon-size);
            height: var(--icon-size);
            border-radius: var(--icon-border-radius);
            box-shadow: inset 0 0 0 0.5px rgba(255, 255, 255, 0.4),
                        0px 6px 15px rgba(0, 0, 0, 0.2);
            display: flex;
            justify-content: center;
            align-items: center;
            position: relative;
            background-color: white;
            flex-shrink: 0;
        }

        .app-label {
            margin-top: 5px;
            font-size: var(--app-label-font-size);
            color: var(--app-label-color);
            line-height: var(--app-label-line-height);
            font-weight: 500;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            max-width: 100%;
        }

        .badge {
            position: absolute;
            top: var(--badge-offset-y);
            right: var(--badge-offset-x);
            background-color: var(--badge-bg);
            color: var(--badge-color);
            font-size: var(--badge-font-size);
            font-weight: bold;
            line-height: 1;
            padding: var(--badge-padding);
            min-width: var(--badge-min-width);
            height: var(--badge-height);
            display: flex;
            justify-content: center;
            align-items: center;
            border-radius: var(--badge-border-radius);
            box-shadow: 0 0 0 2px var(--ios-bg);
            z-index: 5;
        }

        .calendar-icon {
            background-color: white;
            flex-direction: column;
            line-height: 1;
            box-shadow: inset 0 0 0 0.5px rgba(255, 255, 255, 0.4),
                        0px 6px 15px rgba(0, 0, 0, 0.2);
        }
        .calendar-day-name {
            font-size: 8px;
            color: #EE474C;
            font-weight: 600;
            margin-top: 10px;
        }
        .calendar-day-num {
            font-size: 30px;
            font-weight: 500;
            color: #434343;
            margin-top: 0px;
        }

        .clock-icon {
            background-color: black;
            box-shadow: inset 0 0 0 0.5px rgba(255, 255, 255, 0.4),
                        0px 6px 15px rgba(0, 0, 0, 0.2);
        }
        .clock-face {
            width: 80%;
            height: 80%;
            border: 1.5px solid white;
            border-radius: 50%;
            position: relative;
        }
        .clock-center {
            width: 4px;
            height: 4px;
            background-color: white;
            border-radius: 50%;
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            z-index: 2;
        }
        .hour-hand, .minute-hand, .second-hand {
            position: absolute;
            background-color: white;
            transform-origin: bottom center;
            top: 50%;
            left: 50%;
        }
        .hour-hand {
            width: 1.5px;
            height: 25%;
            transform: translate(-50%, -100%) rotate(220deg);
        }
        .minute-hand {
            width: 1px;
            height: 35%;
            transform: translate(-50%, -100%) rotate(290deg);
            background-color: #f7d242;
        }
        .second-hand {
            width: 0.5px;
            height: 38%;
            background-color: red;
            transform: translate(-50%, -100%) rotate(180deg);
        }
        .clock-face div:nth-child(4) { position: absolute; top: 10%; left: 50%; transform: translateX(-50%); font-size: 7px; color: white; font-weight: bold; }
        .clock-face div:nth-child(5) { position: absolute; right: 10%; top: 50%; transform: translateY(-50%); font-size: 7px; color: white; font-weight: bold; }
        .clock-face div:nth-child(6) { position: absolute; bottom: 10%; left: 50%; transform: translateX(-50%); font-size: 7px; color: white; font-weight: bold; }
        .clock-face div:nth-child(7) { position: absolute; left: 10%; top: 50%; transform: translateY(-50%); font-size: 7px; color: white; font-weight: bold; }

        .grey-icon {
            background-color: #E6E6E6;
        }

        .camera-icon svg {
            width: 70%;
            height: 70%;
            fill: #434343;
            filter: drop-shadow(0 1px 0 rgba(255,255,255,0.2));
        }

        .photos-icon {
            background: linear-gradient(135deg, #FFC75F, #FE923C);
            overflow: hidden;
            box-shadow: inset 0 0 0 0.5px rgba(255, 255, 255, 0.4),
                        0px 6px 15px rgba(0, 0, 0, 0.2);
        }
        .photos-icon svg {
            width: 80%;
            height: 80%;
            position: relative;
            filter: drop-shadow(0 1px 0 rgba(0,0,0,0.1));
        }

        .weather-icon {
            background: linear-gradient(to bottom, #5EC0F2, #3086E0);
            box-shadow: inset 0 0 0 0.5px rgba(255, 255, 255, 0.4),
                        0px 6px 15px rgba(0, 0, 0, 0.2);
        }
        .weather-icon .sun {
            width: 25px;
            height: 25px;
            background-color: #FFC94A;
            border-radius: 50%;
            position: absolute;
            top: 15px;
            left: 15px;
            box-shadow: 0 0 0 4px rgba(255, 255, 255, 0.5), inset 0 0 0 2px rgba(255, 255, 255, 0.5);
        }
        .weather-icon .cloud {
            width: 40px;
            height: 25px;
            background-color: white;
            border-radius: 12px;
            position: absolute;
            bottom: 10px;
            right: 10px;
            transform: translateX(-50%);
            z-index: 1;
        }
        .weather-icon .cloud::before,
        .weather-icon .cloud::after {
            content: '';
            position: absolute;
            background-color: white;
            border-radius: 50%;
            top: -5px;
        }
        .weather-icon .cloud::before {
            width: 20px;
            height: 20px;
            left: 5px;
        }
        .weather-icon .cloud::after {
            width: 30px;
            height: 30px;
            left: 15px;
        }

        .settings-icon {
            background-color: #E7E7E7;
        }
        .settings-icon .gear-svg {
            width: 70%;
            height: 70%;
            fill: #6E6E6E;
            filter: drop-shadow(0 1px 0 rgba(255,255,255,0.2));
        }

        .calculator-icon {
            background-color: #E6E6E6;
        }
        .calculator-icon svg {
            width: 70%;
            height: 70%;
            fill: #434343;
            filter: drop-shadow(0 1px 0 rgba(255,255,255,0.2));
        }

        .facebook-icon {
            background-color: #3B5998;
            color: white;
            font-size: 40px;
        }

        .messenger-icon {
            background: linear-gradient(135deg, #0084FF, #00C6FF);
            font-size: 30px;
            color: white;
            filter: drop-shadow(0 1px 0 rgba(255,255,255,0.2));
        }

        .whatsapp-icon {
            background-color: #25D366;
            font-size: 35px;
            color: white;
            filter: drop-shadow(0 1px 0 rgba(255,255,255,0.2));
        }

        .twitter-icon {
            background-color: #1DA1F2;
            font-size: 30px;
            color: white;
            filter: drop-shadow(0 1px 0 rgba(255,255,255,0.2));
        }

        .instagram-icon {
            background: radial-gradient(circle at 30% 107%, #fdf497 0%, #fdf497 5%, #fd5949 45%, #d6249f 60%, #285AEB 90%);
            box-shadow: inset 0 0 0 0.5px rgba(255, 255, 255, 0.4),
                        0px 6px 15px rgba(0, 0, 0, 0.2);
            overflow: hidden;
            position: relative;
        }
        .instagram-icon .camera-body {
            width: 50%;
            height: 50%;
            border: 3px solid white;
            border-radius: 12px;
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
        }
        .instagram-icon .lens {
            width: 45%;
            height: 45%;
            border: 3px solid white;
            border-radius: 50%;
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
        }
        .instagram-icon .flash {
            width: 7px;
            height: 7px;
            background-color: white;
            border-radius: 50%;
            position: absolute;
            top: 15%;
            right: 15%;
        }

        .facetime-icon {
            background-color: #34C759;
            box-shadow: inset 0 0 0 0.5px rgba(255, 255, 255, 0.4),
                        0px 6px 15px rgba(0, 0, 0, 0.2);
        }
        .facetime-icon svg {
            width: 60%;
            height: 60%;
            fill: white;
            filter: drop-shadow(0 1px 0 rgba(0,0,0,0.1));
        }
        
        .maps-icon {
            background: linear-gradient(180deg, #A8DD43 0%, #68B632 100%);
            overflow: hidden;
            box-shadow: inset 0 0 0 0.5px rgba(255, 255, 255, 0.4),
                        0px 6px 15px rgba(0, 0, 0, 0.2);
        }
        .maps-icon .map-background-stripes {
            position: absolute;
            width: 100%;
            height: 100%;
            background: repeating-linear-gradient(
                45deg,
                #68B632,
                #68B632 5px,
                #A8DD43 5px,
                #A8DD43 10px
            );
            transform: rotate(-30deg) scale(1.5);
            opacity: 0.5;
        }
        .maps-icon .map-road-sign {
            position: absolute;
            top: 15px;
            right: 15px;
            width: 30px;
            height: 15px;
            background-color: #61A4FF;
            border-radius: 4px;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 8px;
            font-weight: bold;
            color: white;
            text-shadow: 0 1px 0 rgba(0,0,0,0.2);
            z-index: 2;
        }
        .maps-icon .map-pin {
            position: absolute;
            width: 25px;
            height: 25px;
            background-color: #007AFF;
            border-radius: 50% 50% 50% 0;
            transform: rotate(-45deg);
            bottom: 10px;
            left: 50%;
            margin-left: -12.5px;
            box-shadow: 0 0 0 2px white;
            z-index: 3;
        }
        .maps-icon .map-pin::before {
            content: '';
            position: absolute;
            width: 8px;
            height: 8px;
            background-color: white;
            border-radius: 50%;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            z-index: 4;
            rotate: 45deg;
        }


        .youtube-icon {
            background-color: #FF0000;
            box-shadow: inset 0 0 0 0.5px rgba(255, 255, 255, 0.4),
                        0px 6px 15px rgba(0, 0, 0, 0.2);
        }
        .youtube-icon svg {
            width: 60%;
            height: 60%;
            fill: white;
            filter: drop-shadow(0 1px 0 rgba(0,0,0,0.1));
        }

        .tv-icon {
            background-color: #000000;
            box-shadow: inset 0 0 0 0.5px rgba(255, 255, 255, 0.4),
                        0px 6px 15px rgba(0, 0, 0, 0.2);
        }
        .tv-icon svg {
            width: 60%;
            height: 60%;
            fill: white;
            filter: drop-shadow(0 1px 0 rgba(0,0,0,0.1));
        }

        .reminders-icon {
            background-color: white;
            box-shadow: inset 0 0 0 0.5px rgba(255, 255, 255, 0.4),
                        0px 6px 15px rgba(0, 0, 0, 0.2);
            flex-direction: column;
            gap: 4px;
        }
        .reminder-item {
            display: flex;
            align-items: center;
            gap: 8px;
            position: relative;
        }
        .reminder-item .dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
        }
        .reminder-item .line {
            width: 25px;
            height: 2px;
            background-color: #CCCCCC;
            border-radius: 1px;
        }
        .reminders-icon .reminder-item:nth-child(1) .dot { background-color: #FC6363; }
        .reminders-icon .reminder-item:nth-child(2) .dot { background-color: #63C1FD; }
        .reminders-icon .reminder-item:nth-child(3) .dot { background-color: #FFBF42; }


        .stocks-icon {
            background-color: #000000;
            box-shadow: inset 0 0 0 0.5px rgba(255, 255, 255, 0.4),
                        0px 6px 15px rgba(0, 0, 0, 0.2);
            overflow: hidden;
            position: relative;
        }
        .stocks-icon .graph-line {
            position: absolute;
            width: 100%;
            height: 100%;
        }
        .stocks-icon .graph-line svg {
            width: 100%;
            height: 100%;
            position: absolute;
            top: 0;
            left: 0;
        }

        .books-icon {
            background: linear-gradient(135deg, #FF9C3D 0%, #F57C00 100%);
            box-shadow: inset 0 0 0 0.5px rgba(255, 255, 255, 0.4),
                        0px 6px 15px rgba(0, 0, 0, 0.2);
        }
        .books-icon svg {
            width: 60%;
            height: 60%;
            fill: white;
            filter: drop-shadow(0 1px 0 rgba(0,0,0,0.1));
        }

        .mail-icon {
            background: linear-gradient(to bottom, #72C0FA, #3A9BE9);
            box-shadow: inset 0 0 0 0.5px rgba(255, 255, 255, 0.4),
                        0px 6px 15px rgba(0, 0, 0, 0.2);
        }
        .mail-icon svg {
            width: 70%;
            height: 70%;
            fill: white;
            filter: drop-shadow(0 1px 0 rgba(0,0,0,0.1));
        }

        .podcasts-icon {
            background: linear-gradient(135deg, #A836D6, #800080);
            box-shadow: inset 0 0 0 0.5px rgba(255, 255, 255, 0.4),
                        0px 6px 15px rgba(0, 0, 0, 0.2);
        }
        .podcasts-icon svg {
            width: 60%;
            height: 60%;
            fill: white;
            filter: drop-shadow(0 1px 0 rgba(0,0,0,0.1));
        }

        .appstore-icon {
            background: linear-gradient(135deg, #51BBFF, #007AFF);
            box-shadow: inset 0 0 0 0.5px rgba(255, 255, 255, 0.4),
                        0px 6px 15px rgba(0, 0, 0, 0.2);
        }
        .appstore-icon svg {
            width: 60%;
            height: 60%;
            fill: white;
            filter: drop-shadow(0 1px 0 rgba(0,0,0,0.1));
        }

        .shortcuts-icon {
            background: linear-gradient(45deg, #1C7ED6, #3E66D4, #F24D7B, #F95079);
            box-shadow: inset 0 0 0 0.5px rgba(255, 255, 255, 0.4),
                        0px 6px 15px rgba(0, 0, 0, 0.2);
            overflow: hidden;
            position: relative;
        }
        .shortcuts-icon svg {
            width: 70%;
            height: 70%;
            fill: white;
            filter: drop-shadow(0 1px 0 rgba(0,0,0,0.1));
            opacity: 0.9;
        }

        .notes-icon {
            background-color: white;
            box-shadow: inset 0 0 0 0.5px rgba(255, 255, 255, 0.4),
                        0px 6px 15px rgba(0, 0, 0, 0.2);
            flex-direction: column;
            overflow: hidden;
            align-items: flex-start;
            padding: 8px;
        }
        .notes-header {
            width: 100%;
            height: 8px;
            background-color: #F8D148;
            border-radius: 2px;
            margin-bottom: 5px;
        }
        .notes-line {
            width: 100%;
            height: 2px;
            background-color: #E6E6E6;
            margin-bottom: 3px;
            border-radius: 1px;
        }
        .notes-line:nth-child(4) { width: 80%; }
        .notes-line:last-child { width: 60%; margin-bottom: 0; }


        .pagination {
            display: flex;
            justify-content: center;
            gap: 5px;
            margin-top: 15px;
            margin-bottom: 10px;
        }

        .pagination-dot {
            width: 5px;
            height: 5px;
            background-color: rgba(0, 0, 0, 0.2);
            border-radius: 50%;
        }
        .pagination-dot:nth-child(1) {
            background-color: rgba(0, 0, 0, 0.4);
        }

        .dock {
            position: absolute;
            bottom: 0;
            left: 50%;
            transform: translateX(-50%);
            width: 95%;
            height: var(--dock-height);
            background-color: var(--dock-bg);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border-radius: 25px 25px 0 0;
            display: flex;
            justify-content: space-around;
            align-items: center;
            padding: 0 10px;
            box-shadow: inset 0 0 0 0.5px rgba(255, 255, 255, 0.6),
                        0px -2px 10px rgba(0, 0, 0, 0.1);
        }

        .dock .app-icon-wrapper {
            padding: 0;
        }
        .dock .app-icon {
            width: 65px;
            height: 65px;
            box-shadow: inset 0 0 0 0.5px rgba(255, 255, 255, 0.4),
                        0px 4px 10px rgba(0, 0, 0, 0.1);
        }
        .dock .app-label {
            display: none;
        }

        .compass-icon {
            background: linear-gradient(to bottom, #2B89FC, #0162D0);
            border-radius: 50%;
            box-shadow: inset 0 0 0 0.5px rgba(255, 255, 255, 0.4),
                        0px 4px 10px rgba(0, 0, 0, 0.1);
        }
        .compass-icon .compass-face {
            width: 80%;
            height: 80%;
            border-radius: 50%;
            background-color: white;
            position: relative;
            box-shadow: inset 0 0 0 1px rgba(0,0,0,0.1);
        }
        .compass-icon .compass-needle-red,
        .compass-icon .compass-needle-white {
            position: absolute;
            width: 6px;
            height: 30px;
            background-color: red;
            transform-origin: bottom center;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -100%) rotate(-15deg);
            border-radius: 3px 3px 0 0;
        }
        .compass-icon .compass-needle-white {
            background-color: white;
            transform: translate(-50%, 0%) rotate(165deg);
            border-radius: 0 0 3px 3px;
        }
        .compass-icon .compass-center {
            width: 8px;
            height: 8px;
            background-color: #63C1FD;
            border-radius: 50%;
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            border: 1px solid white;
            z-index: 2;
        }
        .compass-icon .needle-center-dot {
            width: 2px;
            height: 2px;
            background-color: white;
            border-radius: 50%;
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            z-index: 3;
        }
        .compass-icon .degrees {
            position: absolute;
            top: 15px;
            font-size: 8px;
            color: #AAAAAA;
            font-weight: 500;
            left: 50%;
            transform: translateX(-50%);
        }

        .phone-dock-icon {
            background-color: #34C759;
            box-shadow: inset 0 0 0 0.5px rgba(255, 255, 255, 0.4),
                        0px 4px 10px rgba(0, 0, 0, 0.1);
        }
        .phone-dock-icon svg {
            width: 60%;
            height: 60%;
            fill: white;
